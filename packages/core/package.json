{
  "name": "@astronaut/core",
  "version": "0.0.0",
  "private": true,
  "description": "ASTronaut IR types and runtime validators (proto-aligned)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "buf generate && tsc -p tsconfig.json",
    "gen:proto": "buf generate"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.75.0",
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "typescript": "^5.7.2"
  }
}
